{
  "name": "customers",
  "description": "PRESET: Multi-table retail demo — customers -> orders -> lines with FK integrity. Writes one file per table.",
  "seed": 42,
  "rows": 50,
  "columns": [
    {"name": "customer_id", "generator": "pattern", "params": {"pattern": "CUST-#####"}},
    {"name": "name", "generator": "full_name"},
    {"name": "email", "generator": "email"},
    {"name": "city", "generator": "city"},
    {"name": "signed_up", "generator": "date_between", "params": {"start": "2023-01-01", "end": "2025-12-31"}}
  ],
  "output": {"format": "csv"},
  "sink": {"sink": "file", "options": {"path": "out/retail_orders.csv"}},
  "tables": [
    {
      "name": "orders",
      "rows": 200,
      "columns": [
        {"name": "order_id", "generator": "row_id", "params": {"start": 1000}},
        {"name": "customer_id", "generator": "fk", "params": {"table": "customers", "column": "customer_id"}},
        {"name": "ordered_at", "generator": "timestamp_between", "params": {"start": "2025-01-01T00:00:00", "end": "2026-06-30T23:59:59"}},
        {"name": "status", "generator": "choice_weighted", "params": {"values": ["placed", "shipped", "delivered", "returned"], "weights": [0.2, 0.3, 0.45, 0.05]}}
      ]
    },
    {
      "name": "lines",
      "rows": 600,
      "columns": [
        {"name": "line_id", "generator": "row_id", "params": {"start": 1}},
        {"name": "order_id", "generator": "fk", "params": {"table": "orders", "column": "order_id"}},
        {"name": "sku", "generator": "pattern", "params": {"pattern": "SKU-????-###"}},
        {"name": "qty", "generator": "int_range", "params": {"min": 1, "max": 6}},
        {"name": "unit_price", "generator": "money", "params": {"min": 3.0, "max": 250.0}}
      ]
    }
  ]
}
