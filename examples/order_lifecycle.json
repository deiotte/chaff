{
  "name": "order_lifecycle",
  "description": "PRESET: Stateful entities — 200 orders transitioning placed -> shipped -> delivered/returned across 6 ticks. One row per (tick, order).",
  "seed": 42,
  "columns": [
    {"name": "status", "generator": "choice", "params": {"values": ["placed"]}},
    {"name": "amount", "generator": "money", "params": {"min": 10, "max": 500}}
  ],
  "output": {"format": "csv"},
  "sink": {"sink": "file", "options": {"path": "out/order_lifecycle.csv"}},
  "entity": {
    "count": 200,
    "ticks": 6,
    "id_column": "order_id",
    "id_pattern": "ORD-######",
    "tick_column": "step",
    "updates": [
      {"updater": "lifecycle", "params": {"column": "status", "transitions": {
        "placed": {"shipped": 0.9, "placed": 0.1},
        "shipped": {"delivered": 0.85, "returned": 0.15}
      }}}
    ]
  }
}
