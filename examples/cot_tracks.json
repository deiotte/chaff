{
  "name": "cot_tracks",
  "description": "PRESET: Cursor-on-Target feed \u2014 8 tracks moving over 60 ticks, emitted as CoT XML events. Swap the sink for tcp/udp to feed a live TAK server.",
  "seed": 8675309,
  "columns": [
    {
      "name": "lat",
      "generator": "lat",
      "params": {
        "min": 34.0,
        "max": 34.3
      }
    },
    {
      "name": "lon",
      "generator": "lon",
      "params": {
        "min": -118.7,
        "max": -118.2
      }
    },
    {
      "name": "hae",
      "generator": "float_uniform",
      "params": {
        "min": 40.0,
        "max": 220.0
      }
    },
    {
      "name": "speed",
      "generator": "float_uniform",
      "params": {
        "min": 0.0,
        "max": 32.0
      }
    },
    {
      "name": "heading",
      "generator": "int_range",
      "params": {
        "min": 0,
        "max": 359
      }
    },
    {
      "name": "ce",
      "generator": "float_uniform",
      "params": {
        "min": 3.5,
        "max": 45.0
      }
    },
    {
      "name": "le",
      "generator": "float_uniform",
      "params": {
        "min": 5.0,
        "max": 60.0
      }
    },
    {
      "name": "battery",
      "generator": "int_range",
      "params": {
        "min": 12,
        "max": 100
      }
    },
    {
      "name": "callsign",
      "generator": "pattern",
      "params": {
        "pattern": "RAVEN-##"
      }
    }
  ],
  "output": {
    "format": "cot",
    "options": {
      "tick_column": "t",
      "base_time": "2026-01-01T00:00:00Z",
      "interval_seconds": 5,
      "stale_seconds": 30,
      "type": "a-f-A-M-F-Q",
      "geopointsrc": "GPS",
      "altsrc": "GPS",
      "takv_version": "0.1.0"
    }
  },
  "sink": {
    "sink": "file",
    "options": {
      "path": "out/cot_tracks.cot"
    }
  },
  "entity": {
    "count": 8,
    "ticks": 60,
    "id_column": "uid",
    "id_pattern": "ANDROID-####",
    "tick_column": "t",
    "updates": [
      {
        "updater": "movement",
        "params": {
          "speed": 0.008,
          "turn_stddev": 8
        }
      }
    ]
  }
}
