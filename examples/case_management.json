{
  "name": "cases",
  "description": "PRESET: Court case management \u2014 cases, judges, parties, attorneys, docket entries, hearings and an audit trail, all FK-linked. Case numbers like 2-24-CV-01234 agree with the filing date. Writes one file per table.",
  "seed": 4242,
  "rows": 500,
  "columns": [
    {
      "name": "case_id",
      "generator": "row_id",
      "params": {
        "start": 100000
      }
    },
    {
      "name": "court",
      "generator": "choice_weighted",
      "params": {
        "values": [
          "Northern District",
          "Southern District",
          "Eastern District",
          "Western District",
          "Central District",
          "Metro Division",
          "Coastal Division"
        ],
        "weights": [
          0.14,
          0.16,
          0.12,
          0.2,
          0.13,
          0.15,
          0.1
        ]
      }
    },
    {
      "name": "office",
      "generator": "int_range",
      "params": {
        "min": 1,
        "max": 4
      }
    },
    {
      "name": "case_year",
      "generator": "choice_weighted",
      "params": {
        "values": [
          "19",
          "20",
          "21",
          "22",
          "23",
          "24",
          "25",
          "26"
        ],
        "weights": [
          0.04,
          0.05,
          0.07,
          0.1,
          0.14,
          0.2,
          0.25,
          0.15
        ]
      }
    },
    {
      "name": "case_type",
      "generator": "choice_weighted",
      "params": {
        "values": [
          "CV",
          "CR",
          "MC",
          "MJ"
        ],
        "weights": [
          0.62,
          0.26,
          0.06,
          0.06
        ]
      }
    },
    {
      "name": "case_seq",
      "generator": "pattern",
      "params": {
        "pattern": "0####"
      }
    },
    {
      "name": "case_number",
      "generator": "derived",
      "params": {
        "expr": "str(office) + '-' + case_year + '-' + case_type + '-' + case_seq"
      }
    },
    {
      "name": "nos_candidate",
      "generator": "choice_weighted",
      "params": {
        "values": [
          "Contract",
          "Personal Injury",
          "Civil Rights",
          "Employment",
          "Habeas Corpus",
          "Prisoner Civil Rights",
          "Patent",
          "Trademark",
          "Other Statutory Action",
          "Administrative Appeal"
        ],
        "weights": [
          0.14,
          0.1,
          0.14,
          0.12,
          0.08,
          0.1,
          0.06,
          0.05,
          0.13,
          0.08
        ]
      }
    },
    {
      "name": "nature_of_suit",
      "generator": "derived",
      "params": {
        "expr": "nos_candidate if case_type == 'CV' else None"
      }
    },
    {
      "name": "assigned_judge_id",
      "generator": "fk",
      "params": {
        "table": "judges",
        "column": "judge_id"
      }
    },
    {
      "name": "referred_magistrate_id",
      "generator": "fk",
      "params": {
        "table": "judges",
        "column": "judge_id"
      }
    },
    {
      "name": "status",
      "generator": "choice_weighted",
      "params": {
        "values": [
          "Open",
          "Pending Motion",
          "Stayed",
          "Closed",
          "Reopened",
          "On Appeal"
        ],
        "weights": [
          0.38,
          0.17,
          0.04,
          0.33,
          0.03,
          0.05
        ]
      }
    },
    {
      "name": "jury_demand",
      "generator": "choice_weighted",
      "params": {
        "values": [
          "None",
          "Plaintiff",
          "Defendant",
          "Both"
        ],
        "weights": [
          0.55,
          0.25,
          0.08,
          0.12
        ]
      }
    },
    {
      "name": "sealed",
      "generator": "bool_rate",
      "params": {
        "true_rate": 0.03
      }
    },
    {
      "name": "filed_month",
      "generator": "int_range",
      "params": {
        "min": 1,
        "max": 12
      }
    },
    {
      "name": "filed_day",
      "generator": "int_range",
      "params": {
        "min": 1,
        "max": 28
      }
    },
    {
      "name": "date_filed",
      "generator": "derived",
      "params": {
        "expr": "min('20' + case_year + '-' + ('0' if filed_month < 10 else '') + str(filed_month) + '-' + ('0' if filed_day < 10 else '') + str(filed_day), '2026-09-30')"
      }
    },
    {
      "name": "years_open",
      "generator": "choice_weighted",
      "params": {
        "values": [
          0,
          1,
          2,
          3,
          4
        ],
        "weights": [
          0.3,
          0.32,
          0.2,
          0.12,
          0.06
        ]
      }
    },
    {
      "name": "term_month",
      "generator": "int_range",
      "params": {
        "min": 1,
        "max": 12
      }
    },
    {
      "name": "term_day",
      "generator": "int_range",
      "params": {
        "min": 1,
        "max": 28
      }
    },
    {
      "name": "date_terminated",
      "generator": "derived",
      "params": {
        "expr": "min(max('20' + str(int(case_year) + years_open) + '-' + ('0' if term_month < 10 else '') + str(term_month) + '-' + ('0' if term_day < 10 else '') + str(term_day), date_filed), '2026-09-30') if status == 'Closed' else None"
      }
    },
    {
      "name": "demand_amount",
      "generator": "lognormal",
      "params": {
        "mu": 11.5,
        "sigma": 1.4,
        "precision": 2
      }
    }
  ],
  "output": {
    "format": "csv"
  },
  "sink": {
    "sink": "file",
    "options": {
      "path": "out/case_management.csv"
    }
  },
  "tables": [
