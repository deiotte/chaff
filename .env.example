# chaff — optional settings. Copy this file to `.env`, fill in what you want,
# then run `docker compose up --build`. Everything here is OPTIONAL: with no
# .env at all, chaff still runs — you just won't see the "Describe it in
# English" button work (it needs an API key).
#
# `.env` is git-ignored, so your key never gets committed.

# ── "Describe it in English" (optional) ──────────────────────────────
# Set ONE of these to a real API key to turn on AI drafting. The key stays
# on the server; the browser never sees it. If more than one is set, the
# order of preference is Anthropic, then OpenAI, then Google.

# Anthropic (Claude) — works with the default image, nothing else to do.
ANTHROPIC_API_KEY=

# OpenAI (GPT) — also set CHAFF_EXTRAS=api,nl-openai below and rebuild.
OPENAI_API_KEY=

# Google (Gemini) — also set CHAFF_EXTRAS=api,nl-google below and rebuild.
GOOGLE_API_KEY=

# ── Which LLM SDK to install in the image (optional) ─────────────────
# Default is Anthropic (api,nl). Only change this if you're using OpenAI or
# Google above. After changing it, run `docker compose up --build`.
# CHAFF_EXTRAS=api,nl-openai
