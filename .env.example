# chaff — optional settings. Copy this file to `.env`, fill in what you want,
# then run `docker compose up --build`. Everything here is OPTIONAL.
#
# NOTE: the easiest way to use "Describe it in English" is to just paste your
# API key into the box in the UI — no file editing, no rebuild. This file is
# only for teams who'd rather keep the key on the SERVER instead.
#
# `.env` is git-ignored, so your key never gets committed.

# ── Server-side "Describe it in English" key (optional) ──────────────
# Set ONE of these to use a server-managed key (the browser never sees it).
# If more than one is set, preference is Anthropic, then OpenAI, then Google.

# Anthropic (Claude) — works with the default image.
ANTHROPIC_API_KEY=

# OpenAI (GPT) — works with the default image.
OPENAI_API_KEY=

# Google (Gemini) — also set CHAFF_EXTRAS below and rebuild (its SDK isn't
# in the default image).
GOOGLE_API_KEY=

# ── Which LLM SDKs to install in the image (optional) ────────────────
# Default bakes in Anthropic + OpenAI (api,nl,nl-openai), so a Claude or GPT
# key — pasted in the UI or set above — works with no rebuild. Add Google:
# CHAFF_EXTRAS=api,nl,nl-openai,nl-google

# ── Exposing chaff beyond localhost (optional, ADR-0018) ─────────────
# chaff's defaults assume a single operator on localhost. If you put the
# streaming surface on a network, set these. Left blank = the zero-config
# local demo (no auth, only cloud-metadata/link-local egress is ever blocked).

# Where Compose publishes the API. Default 127.0.0.1 = reachable from this
# machine only, which is what chaff's no-auth defaults assume. Set 0.0.0.0 to
# expose it on the network — and set CHAFF_API_TOKEN below when you do, or you
# are handing an unauthenticated API to everyone who can route to this host.
# CHAFF_BIND=0.0.0.0

# Require a shared token on EVERY API route (ADR-0025). Paste the same value
# into the UI's "Access token" box in the header.
#   set   -> required from every client, localhost included (a reverse proxy
#            makes every request look local, so exempting loopback would
#            silently disable auth for exactly that deployment)
#   unset -> localhost is served, remote callers get a 401 explaining this
CHAFF_API_TOKEN=

# Allowlist of destination hosts push jobs may connect to (comma-separated).
# Unset = any host except the always-blocked cloud-metadata/link-local range.
CHAFF_STREAM_ALLOWED_HOSTS=

# Hard ceilings every stream/job is clamped to (defaults shown). Lower them to
# tighten the guardrail on an exposed instance.
# CHAFF_STREAM_MAX_RECORDS=1000000
# CHAFF_STREAM_MAX_SECONDS=300

# How many push jobs may run at once. The two ceilings above bound how *long*
# each job runs, not how many start; each active job holds a thread and a
# socket. A 9th start is refused with 429 until one finishes or is stopped.
# CHAFF_STREAM_MAX_ACTIVE_JOBS=8

# Cost controls for "Describe it in English" (/draft) — the one route that
# spends money rather than CPU. The rate is per client address; each request
# can cost two LLM calls, since an invalid draft is retried once.
# Set the rate to 0 to turn drafting off entirely.
# CHAFF_DRAFT_MAX_CHARS=4000
# CHAFF_DRAFT_RATE_PER_MINUTE=10
# CHAFF_DRAFT_TIMEOUT_SECONDS=60

# Escape hatch: allow streaming to link-local/metadata addresses (rare; only
# for a fully trusted deployment that genuinely needs it).
# CHAFF_STREAM_ALLOW_LINK_LOCAL=1

# Where push jobs may send data (ADR-0026).
#   strict     -> only globally-routable public addresses; loopback, RFC1918,
#                 CGNAT, multicast and reserved ranges are refused unless the
#                 host is in CHAFF_STREAM_ALLOWED_HOSTS above
#   permissive -> only link-local/metadata is blocked (the local-tool default)
# Unset follows CHAFF_API_TOKEN: a token means this is a network service, so
# strict; no token means it's your own machine, so permissive — pushing demo
# data to your own broker on localhost or 10.x is the feature working.
# CHAFF_STREAM_EGRESS=strict

# ── Sink credentials (ADR-0027) ──────────────────────────────────────
# A saved spec is a shareable document, so chaff refuses to save one that
# contains a literal secret. Reference the environment instead — put
# "${MY_SINK_TOKEN}" in the spec field and set the variable here:
#
#   MY_SINK_TOKEN=Bearer abc123
#
# The name is yours to choose. Docker Compose only passes variables it lists
# explicitly, so add your own to the `environment:` block in
# docker-compose.yml alongside the CHAFF_* settings — otherwise the
# placeholder stays unresolved and the sink fails with a clear error rather
# than sending an empty credential.
